<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>CodeMetrics.Cli</id>
    <version>1.2.0</version>
    <authors>quicksln</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/quicksln/CodeMetrics.CLI</projectUrl>
    <description>CodeMetrics.Cli measures cyclomatic and cognitive complexity for C# source files with a fast syntax-only Roslyn workflow.</description>
    <releaseNotes>New `--format markdown` writes an agent-readable GitHub-flavoured report: a summary table with the same headline figures the HTML dashboard shows (members, files, total lines, class/record/enum counts, cognitive and cyclomatic avg/median/p90/max, MI avg and minimum, highest-risk member), risk bands, a member table using the CSV column set, and the gate result. `--top` limits member rows and `--top 0` prints every member; summary and band figures always cover the whole population. Purely additive: table, csv, json and html output are unchanged.</releaseNotes>
    <copyright>Copyright © quicksln</copyright>
    <tags>code-metrics complexity csharp analyzers cli dotnet-tool</tags>
    <packageTypes>
      <packageType name="DotnetTool" />
    </packageTypes>
    <repository type="git" url="https://github.com/quicksln/CodeMetrics.CLI" commit="4ead5bd58cea531a5db9a249d8455398d8c24391" />
  </metadata>
</package>